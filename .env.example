# Copy to .env on your machine. NEVER commit .env.

# --- WASP HUB (runs on Pablo's PC) ---
# Everyone else points to Pablo's LAN IP. Pablo uses localhost.
WASP_HUB_URL=ws://localhost:7331
WASP_HUB_PORT=7331

# Which agent this machine runs: architect | researcher | operator | security
WASP_AGENT=architect

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
WASP_CLAUDE_MODEL=claude-opus-5
# WASP_CLAUDE_EFFORT=medium         # low | medium | high | xhigh | max — CYAN's reasoning depth (latency vs quality)
# WASP_ARCHITECT_MODE=claude        # claude | deterministic (fixed script, used automatically without credentials)

# --- ORANGE (Felipe) ---
# WASP_OPERATOR_UI_PORT=7003        # ORANGE face; 0 disables. `npm run operator -- --fake-docker` when Docker is absent

# --- GREEN (Juanda) ---
# WASP_SECURITY_UI_PORT=7004        # GREEN face; 0 disables
# WASP_SECURITY_LANG=es             # es | en for GREEN's spoken lines
# WASP_PERMISSION_TIMEOUT_MS=0      # 0 = pending permissions never expire (live demo)

# --- CYAN CLI (Pablo) ---
# WASP_AUTO_ANSWER=yes              # yes | no | stop | maybe — non-interactive human answer for rehearsals
# WASP_AUTO_REQUEST=...             # request to use when `npm run architect` is started without one (rehearsals)

# --- Voice (owned by Andrea / MAGENTA; fill in when packages/voice lands) ---
# WASP_TTS_PROVIDER=
# WASP_STT_PROVIDER=
