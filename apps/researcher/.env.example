# MAGENTA / researcher. Copy to .env, never commit .env. Loaded by your shell, not by the app.

# Pablo's hub. On Pablo's PC: ws://localhost:7331. Everyone else: ws://<pablo-lan-ip>:7331
WASP_HUB_URL=ws://localhost:7331

# Live web research through the Claude API. Without it MAGENTA runs in honest CATALOG mode.
ANTHROPIC_API_KEY=

# 1 = HEAD-check catalog URLs to add reachability evidence (needs internet).
WASP_CHECK_URLS=0

# UI (Vite). Defaults to ws://<page-host>:7331 when empty.
VITE_WASP_HUB_URL=
