{
  "name": "wasp",
  "private": true,
  "version": "0.1.0",
  "description": "WASP — multi-agent AI operations system (Claude API). Four agents, one hub, one context.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
